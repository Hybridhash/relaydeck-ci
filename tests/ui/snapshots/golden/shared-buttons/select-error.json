       "type": "Row"
      }
     ],
     "key": "select-text-sheet",
     "props": {
      "expand": true,
      "spacing": 8
     },
     "slot": "body",
     "type": "Column"
    }
   ],
   "slot": "root",
   "type": "Component:SelectTextSheet"
  }
 ]
}
